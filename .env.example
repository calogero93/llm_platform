# Copy to .env and adjust. Never commit .env.
# Backend: vllm | mock
LLMP_LLM_BACKEND=mock
LLMP_LLM_MODEL=default
LLMP_VLLM_BASE_URL=http://vllm:8000
# Mock mode: schema | replay
LLMP_MOCK_MODE=schema
LLMP_CASSETTE_DIR=cassettes
LLMP_LOG_LEVEL=INFO
# Host port for the API (compose)
LLMP_API_PORT=8080
