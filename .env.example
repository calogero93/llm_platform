# Copy to .env and adjust. Never commit .env.
# Backend: vllm | mock
LLMP_LLM_BACKEND=mock
LLMP_LLM_MODEL=default
LLMP_VLLM_BASE_URL=http://vllm:8000
# Mock mode: schema | replay
LLMP_MOCK_MODE=schema
LLMP_CASSETTE_DIR=cassettes
LLMP_LOG_LEVEL=INFO
# Host port for the API (compose)
LLMP_API_PORT=8080
# Traces: OTLP/HTTP endpoint (empty = not exported). `make up` points it at Phoenix.
LLMP_OTLP_TRACES_ENDPOINT=
# Host port for the Phoenix UI (compose)
PHOENIX_PORT=6006
# vLLM preset from deploy/vllm/presets (compose / make up)
VLLM_PRESET=qwen3.5-4b-awq
